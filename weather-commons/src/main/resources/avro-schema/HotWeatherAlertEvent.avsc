{
  "type": "record",
  "name": "HotWeatherAlertEvent",
  "namespace": "org.sideprj.openweathermicroservices.avro",
  "fields": [
    {
      "name": "alertId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      }
    },
    {
      "name": "city",
      "type": "string"
    },
    {
      "name": "country",
      "type": "string"
    },
    {
      "name": "temperature",
      "type": "double"
    },
    {
      "name": "humidity",
      "type": "double"
    },
    {
      "name": "windSpeed",
      "type": "double"
    },
    {
      "name": "pressure",
      "type": "double"
    },
    {
      "name": "heatIndex",
      "type": "double"
    },
    {
      "name": "dewPoint",
      "type": "double"
    },
    {
      "name": "temperatureDeviation",
      "type": "double"
    },
    {
      "name": "ruleId",
      "type": "string"
    },
    {
      "name": "ruleDescription",
      "type": "string"
    },
    {
      "name": "severity",
      "type": {
        "type": "enum",
        "name": "AlertSeverity",
        "symbols": [
          "INFO",
          "WARNING",
          "CRITICAL"
        ]
      }
    },
    {
      "name": "detectedAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "sourceEventId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      }
    },
    {
      "name": "correlationId",
      "type": "string"
    },
    {
      "name": "dataQuality",
      "type": {
        "type": "enum",
        "name": "DataQuality",
        "symbols": [
          "VALID",
          "INVALID",
          "DUPLICATE",
          "OUT_OF_RANGE"
        ]
      }
    },
    {
      "name": "source",
      "type": "string",
      "default": "WeatherAnalyticsService"
    }
  ]
}
